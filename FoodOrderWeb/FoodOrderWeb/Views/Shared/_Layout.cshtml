<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FoodOrderWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FoodOrderWeb.styles.css" asp-append-version="true" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-success border-bottom box-shadow mb-3 fixed-top">
            <div class="container-xl">
                <a class="navbar-brand fw-bold fst-italic fs-3 text-light" asp-area="" asp-controller="Home" asp-action="Index">
                    GreenGo <i class="fa-solid fa-truck-fast"></i>
				</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav mx-auto">
                        <li class="nav-item mx-4">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                        </li>
                        <li class="nav-item mx-lg-4">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Privacy">Cata 1</a>
                        </li>
                        <li class="nav-item mx-lg-4">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Privacy">Cata 2</a>
                        </li>
                        <li class="nav-item mx-lg-4">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Privacy">Cata 3</a>
                        </li>
                        <li class="nav-item mx-lg-4">
                            <a class="nav-link text-light" asp-area="" asp-controller="Home" asp-action="Privacy">cata 4</a>
                        </li>
                    </ul>

                    <form action="/" method="post">
                        <button type="button" class="btn btn-outline-light rounded-1 px-lg-4">
                            <i class="fas fa-right-to-bracket"></i>
                        </button>
                    </form>
                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1 d-flex" style="padding-top:80px;">
        <div class="container">
            @RenderBody()
        </div>
    </main>

    <footer class="border-top text-light bg-success mt-auto py-4">
        <div class="container">
            <div class="row">
                <!-- Cột 1 -->
                <div class="col-md-4 mb-3">
                    <h6>Tải ứng dụng</h6>
                    <div>image 1</div>
                    <div>image 2</div>
                </div>
                <!-- Cột 2 -->
                <div class="col-md-4 mb-3">
                    <h6>Thông tin</h6>
                    <p>Giới thiệu</p>
                    <p>Chính sách</p>
                    <p>Hỗ trợ</p>
                </div>
                <!-- Cột 3 -->
                <div class="col-md-4 mb-3">
                    <h6>Liên hệ</h6>
                    <p>Email: cskh@greengo.com</p>
                    <p>Hotline: 0123 456 789</p>
                </div>
            </div>
            <div class="row">
                <!-- Cột 1 -->
                <div class="col-md-4 mb-3">
                    <h6>Tải ứng dụng</h6>
                    <div>image 1</div>
                    <div>image 2</div>
                </div>
                <!-- Cột 2 -->
                <div class="col-md-4 mb-3">
                    <h6>Thông tin</h6>
                    <p>Giới thiệu</p>
                    <p>Chính sách</p>
                    <p>Hỗ trợ</p>
                </div>
                <!-- Cột 3 -->
                <div class="col-md-4 mb-3">
                    <h6>Liên hệ</h6>
                    <p>Email: cskh@greengo.com</p>
                    <p>Hotline: 0123 456 789</p>
                </div>
            </div>
            <hr class="border-light" />
            <div class="text-center">
                <small>© 2025 - FoodOrderWeb</small>
            </div>
        </div>
    </footer>
    
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
