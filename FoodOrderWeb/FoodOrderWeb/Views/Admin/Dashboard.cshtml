@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container mt-4">
    <h2>📊 Admin Dashboard</h2>
    <div class="row">
        <div class="col-md-3">
            <div class="card shadow p-3">
                <h5>Total Users</h5>
                <h2>@ViewBag.TotalUsers</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow p-3">
                <h5>Customers</h5>
                <h2>@ViewBag.TotalCustomers</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow p-3">
                <h5>Owners</h5>
                <h2>@ViewBag.TotalOwners</h2>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card shadow p-3">
                <h5>Admins</h5>
                <h2>@ViewBag.TotalAdmins</h2>
            </div>
        </div>
    </div>
</div>
