@{
    ViewData["Title"] = "Login";
}

<style>
    body {
        background: #f5f7fa;
        font-family: Arial, sans-serif;
        margin-bottom: 60px;
        background-image: url('/image/image3.jpeg');
        background-size: cover;
        background-repeat: no-repeat;
        background-position: center;
        background-attachment: fixed;
    }

    .login-wrapper {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 90vh; 
    }

    .loginform {
        background: #ffffff;
        padding: 30px;
        border-radius: 15px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.1);
        width: 100%;
		max-width: 380px;
		background: rgba(255, 255, 255, 0.1);
		border: 1px solid rgba(255, 255, 255, 0.3);
    }

        .loginform h3 {
            font-weight: 600;
            color: #333;
        }

        .loginform .form-control {
            border-radius: 10px;
            padding: 10px 15px;
        }

        .loginform button {
            border-radius: 10px;
            padding: 10px;
            font-weight: 600;

        }
</style>

<div class="login-wrapper">
    <div class="loginform">
        <h3 class="text-center mb-4"><i class="fa-solid fa-user"></i></h3>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-action="Login" method="post">
            <div class="mb-3">
                <label for="email" class="form-label mb-1">Email</label>
                <input type="text" class="form-control" id="email" name="email" required />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label mb-1">Mật khẩu</label>
                <input type="password" class="form-control" id="password" name="password" required />
            </div>
            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" id="policyCheck" required>
                <label class="form-check-label" for="policyCheck">
                    <a href="/Login/Policy" target="_blank">Policy</a>
                </label>
            </div>
            <button type="submit" class="btn btn-primary w-100">Login</button>
        </form>
    </div>
</div>
